==== uptime
strata$ uptime
up #.# s, # processes, # context switches (# KiB moved), # kernel code units paged in
==== free
strata$ free
total: # KiB (# MiB)
free: # KiB (# MiB)
processes: #
==== cores
strata$ cores
core #: system
core #: ~, # runnable, # processes, server, solo; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes, server; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes, server, solo; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes, server, solo; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes, server; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes; # switches, # KiB moved, # slots free
core #: ~, # runnable, # processes; # switches, # KiB moved, # slots free
==== ps
strata$ ps
 PID PPID STATE CORE CPUS SWITCHES KIB NAME
 # # ~ # # # # dev (server)
