# strata_core (formal/props/strata_core.svh), with two cores' worth of
# parameters, 4 KiB Local Stores and a 4-entry overlay map. The Local Store
# memories, the multiplier, the divider and the Transfer Unit are cut out
# (their outputs are free).
#   base    x0, capability shape, liveness, the contracts with the Transfer
#           Unit and the top level: by induction
#   traps   the specified traps are delivered as the emulator's trap()
#   prec    a cycle that retires nothing changes no architectural state
#   priv    user mode cannot do or change what is the supervisor's
#   lin     write access to a far byte is never duplicated
#   cover   the properties are not vacuous: traps taken, instructions
#           retired, gifts given and taken. From any state (F_FREE), because
#           from reset the 256-cycle reset sequencer makes each cover take
#           the solver half an hour
#   reset   from reset, through the reset sequencer, to the first
#           instruction's execute cycle
# The groups are separate tasks only to keep each induction small; every
# task also proves the base invariants.
[tasks]
base p
traps p
prec p
priv p
lin p
cover
reset

[options]
p: mode prove
p: depth 2
cover: mode cover
cover: depth 6
reset: mode cover
reset: depth 262
# (nothing can be covered inside the reset sequencer: do not look there)
reset: skip 256

[engines]
smtbmc bitwuzla

[script]
read_verilog -formal -sv strata.v
base: hierarchy -top strata_core -chparam F_GRP 9 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
traps: hierarchy -top strata_core -chparam F_GRP 1 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
prec: hierarchy -top strata_core -chparam F_GRP 2 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
priv: hierarchy -top strata_core -chparam F_GRP 3 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
lin: hierarchy -top strata_core -chparam F_GRP 4 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
cover: hierarchy -top strata_core -chparam F_GRP 0 -chparam F_FREE 1 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
reset: hierarchy -top strata_core -chparam F_GRP 9 -chparam NCORES 2 -chparam NXMAP 4 -chparam DLS_KIB 4 -chparam ILS_KIB 4
cutpoint */t:*strata_ram* */t:*strata_mul* */t:*strata_div* */t:*strata_tu*
prep -top strata_core
memory_map */xm_v */xm_sp */xm_far */xm_ils

[files]
formal/build/strata.v
