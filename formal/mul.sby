# strata_mul (formal/props/strata_mul.svh).
#   prove  the invariants, by induction: the sum of the four partial
#          products, 4 cycles after start
#   cover  the properties are not vacuous
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2

cover: mode cover
cover: depth 12

[engines]
smtbmc bitwuzla

[script]
read_verilog -formal -sv strata.v
prep -top strata_mul

[files]
formal/build/strata.v
