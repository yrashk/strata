# strata_decode against its specification (formal/spec/decode_spec.sv).
# Combinational: one time step decides it.
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
depth 1

[engines]
smtbmc bitwuzla

[script]
read_verilog -formal -sv strata.v
prep -top decode_spec

[files]
formal/build/strata.v
