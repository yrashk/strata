# strata_bus (formal/props/strata_bus.svh).
#   prove   the safety properties, by induction, NM = 3 (a core's two masters
#           and the disk)
#   prove5  the same, NM = 5 (two cores and the disk)
#   live    with the fairness assumptions: a request is granted within
#           NM * (F_T + 2) cycles (NM = 3, F_T = 4: 18). The induction
#           length is that bound plus two, so that a counterexample would have
#           to show the whole wait.
#   cover   the properties are not vacuous
[tasks]
prove
prove5
live
cover

[options]
prove: mode prove
prove: depth 3
prove5: mode prove
prove5: depth 3
live: mode prove
live: depth 20
cover: mode cover
cover: depth 30

[engines]
smtbmc yices

[script]
read_verilog -formal -sv strata.v
prove5: chparam -set NM 5 strata_bus
live: chparam -set F_LIVE 1 strata_bus
cover: chparam -set F_LIVE 1 strata_bus
prep -top strata_bus

[files]
formal/build/strata.v
